# Пример переменных окружения для бэкенда ИС «Тропа».
# Скопируйте этот файл в .env и подставьте реальные значения.
# Файл .env в репозиторий НЕ попадёт (он в .gitignore).

# База данных PostgreSQL + PostGIS
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tropa

# Безопасность
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Кеш Redis
REDIS_URL=redis://localhost:6379/0

# YandexGPT (СЕРВЕРНЫЙ СЕКРЕТ!)
YANDEX_GPT_API_KEY=change_me
YANDEX_GPT_FOLDER_ID=change_me

# Прочее
CORS_ORIGINS=http://localhost:5173
