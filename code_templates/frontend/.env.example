# Пример переменных окружения для клиентской части ИС «Тропа».
# Скопируйте этот файл в .env и подставьте реальные значения.
# Файл .env в репозиторий НЕ попадёт (он в .gitignore).
#
# Внимание: переменные с префиксом VITE_ попадают в сборку и видны в браузере.
# Ключ Яндекс.Карт — публичный (ограничивается по домену), но .env всё равно
# не коммитим.

VITE_YANDEX_MAPS_API_KEY=change_me
VITE_API_BASE_URL=http://localhost:8000
